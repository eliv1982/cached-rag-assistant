# Конфигурация для RAG-ассистента
# Скопируйте этот файл в .env и заполните значения

# API ключ OpenAI (обязательно!)
# Используется как для генерации ответов, так и для создания эмбеддингов
# Получите ключ на https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Опционально: настройки модели для генерации ответов
# MODEL_NAME=gpt-3.5-turbo
# TEMPERATURE=0.7

# Опционально: настройки модели для эмбеддингов
# EMBEDDING_MODEL=text-embedding-3-small
# Альтернативы: text-embedding-3-large, text-embedding-ada-002

# Опционально: настройки векторной базы
# CHROMA_PERSIST_DIR=./chroma_db

# Опционально: настройки кеша
# CACHE_FILE=cache.json

# Опционально: поиск только по чанкам с metadata source (точное имя документа при индексации)
# Пример для встроенных демо-документов: Python Основы | Машинное обучение и AI | Векторные базы данных
# RAG_SOURCE_FILTER=Python Основы

